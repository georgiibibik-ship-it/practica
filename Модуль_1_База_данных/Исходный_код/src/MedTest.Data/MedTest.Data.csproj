<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MedTest.Core/MedTest.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <EmbeddedResource Include="Migrations/*.sql" LogicalName="MedTest.Data.Migrations.%(Filename).sql" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MedTest.Tests" />
  </ItemGroup>
</Project>
